# deploy/autopilot/.env — installation-specific, NON-secret settings for docker compose (copy from this file).
# Address the UI/API listens on. Keep 127.0.0.1 unless the host firewall restricts who can reach it.
AUTOPILOT_BIND_HOST=127.0.0.1
AUTOPILOT_BIND_PORT=8000
# Autopilot configuration for YOUR lab (git-ignored). The installer creates it from autopilot.example.yaml if absent.
AUTOPILOT_CONFIG_FILE=./autopilot.local.yaml
# Persistent data (SQLite database, snapshots). Must be writable by uid 10001/10002 (group 10010).
AUTOPILOT_DATA=/var/lib/autopilot
# Directory holding autopilot.env and deployer/ credential files (mode 0700, outside this repository).
APLAB_SECRETS=/opt/aplab/secrets
# Lab CA bundle and validation identities used by the validator (generated for YOUR lab; never committed).
APLAB_PKI=/opt/aplab/pki
# Optional OpenTelemetry collector (empty = disabled).
OTEL_EXPORTER_OTLP_ENDPOINT=
# LLM assistance (optional): none | openai-compatible (e.g. Ollama: LLM_BASE_URL=http://<host>:11434/v1) | anthropic (LLM_MODEL=claude-...)
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=qwen2.5:3b
