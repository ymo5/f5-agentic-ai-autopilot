# ${APLAB_SECRETS}/autopilot.env — SECRETS for the web container. Never commit the real file. Mode 0600.
# Generate values with: scripts/gen-secrets.sh  (prints nothing secret to the terminal; writes files with mode 0600)
# Session signing key (>= 32 characters).
AUTOPILOT_SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX
# Shared token between the web container and the deployer (the deployer reads the same value from deployer/deployer_token).
AUTOPILOT_DEPLOYER_TOKEN=REPLACE_WITH_RANDOM_64_HEX
# Optional: SHA-256 (hex) of the bearer token accepted by POST /api/observe/snapshot (scripts/observe-collect.sh upload).
AUTOPILOT_OPERATOR_TOKEN_SHA256=
# Optional LLM credentials (only for LLM_PROVIDER=anthropic or a protected OpenAI-compatible endpoint).
ANTHROPIC_API_KEY=
LLM_API_KEY=
