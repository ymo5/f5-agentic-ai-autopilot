# Pinned BIG-IP management public keys for scripts/observe-collect.sh (curl --pinnedpubkey format).
# Obtain the value for YOUR device out of band, e.g.:
#   openssl s_client -connect <bigip-mgmt>:443 </dev/null 2>/dev/null | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
# Copy to config/f5-tls-pins.env.
BIGIP_PIN=sha256//REPLACE_WITH_BASE64_SHA256_OF_THE_DEVICE_PUBLIC_KEY=
